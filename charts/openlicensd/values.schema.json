{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      },
      "required": ["repository", "pullPolicy"]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": ["name"]
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "global": {
      "type": "object",
      "additionalProperties": true
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "name": {
          "type": "string"
        }
      }
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 1
        },
        "targetCPUUtilizationPercentage": {
          "oneOf": [
            { "type": "integer", "minimum": 1, "maximum": 100 },
            { "type": "string" }
          ]
        },
        "targetMemoryUtilizationPercentage": {
          "oneOf": [
            { "type": "integer", "minimum": 1, "maximum": 100 },
            { "type": "string" }
          ]
        },
        "behavior": {
          "type": "object"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "pdb": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "string" }
          ]
        },
        "maxUnavailable": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "string" }
          ]
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interval": {
          "type": "string"
        },
        "scrapeTimeout": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "honorLabels": {
          "type": "boolean"
        },
        "relabelings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "metricRelabelings": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "allowExternal": {
          "type": "boolean"
        },
        "allowExternalEgress": {
          "type": "boolean"
        },
        "extraIngress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extraEgress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "addr": {
          "type": "string"
        },
        "sessionTTLHours": {
          "type": "integer",
          "minimum": 1
        },
        "requestTimeoutSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "requestBodyMaxBytes": {
          "type": "integer",
          "minimum": 1
        },
        "sessionCleanupIntervalMinutes": {
          "type": "integer",
          "minimum": 0
        },
        "auditRetentionDays": {
          "type": "integer",
          "minimum": 0
        },
        "auditCleanupIntervalMinutes": {
          "type": "integer",
          "minimum": 0
        },
        "cookieSecure": {
          "type": "boolean"
        },
        "localLoginEnabled": {
          "type": "boolean"
        },
        "log": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "level": {
              "type": "string",
              "enum": ["debug", "info", "warn", "error"]
            },
            "format": {
              "type": "string",
              "enum": ["json", "text"]
            }
          }
        },
        "trustedProxies": {
          "type": "string"
        },
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "addr": {
              "type": "string"
            }
          }
        },
        "database": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "name": {
              "type": "string"
            },
            "user": {
              "type": "string"
            },
            "sslmode": {
              "type": "string"
            },
            "options": {
              "type": "string"
            },
            "maxConns": {
              "type": "integer",
              "minimum": 0
            },
            "minConns": {
              "type": "integer",
              "minimum": 0
            },
            "maxConnIdleMinutes": {
              "type": "integer",
              "minimum": 0
            },
            "statementTimeoutSeconds": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "rateLimit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "backend": {
              "type": "string",
              "enum": ["memory", "postgres"]
            },
            "publicPerMinute": {
              "type": "integer",
              "minimum": 1
            },
            "publicBurst": {
              "type": "integer",
              "minimum": 1
            },
            "loginPerMinute": {
              "type": "integer",
              "minimum": 1
            },
            "loginBurst": {
              "type": "integer",
              "minimum": 1
            },
            "authenticatedPerMinute": {
              "type": "integer",
              "minimum": 1
            },
            "authenticatedBurst": {
              "type": "integer",
              "minimum": 1
            },
            "idleMinutes": {
              "type": "integer",
              "minimum": 1
            },
            "failOpen": {
              "type": "boolean"
            }
          }
        },
        "bootstrapAdmin": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "email": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          }
        },
        "harbor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "url": {
              "type": "string"
            },
            "projects": {
              "type": "string"
            },
            "robotDurationDays": {
              "type": "integer",
              "minimum": 1
            },
            "robotNamePrefix": {
              "type": "string"
            },
            "insecureSkipVerify": {
              "type": "boolean"
            },
            "debug": {
              "type": "boolean"
            }
          }
        },
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "issuerUrl": {
              "type": "string"
            },
            "clientId": {
              "type": "string"
            },
            "redirectUrl": {
              "type": "string"
            },
            "scopes": {
              "type": "string"
            },
            "defaultRole": {
              "type": "string"
            },
            "providerName": {
              "type": "string"
            },
            "adminEmails": {
              "type": "string"
            }
          }
        }
      }
    },
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["create", "existing", "externalSecrets"]
        },
        "name": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "databasePassword": {
              "type": "string"
            },
            "bootstrapAdminPasswordHash": {
              "type": "string"
            },
            "oidcClientSecret": {
              "type": "string"
            },
            "harborAdminUsername": {
              "type": "string"
            },
            "harborAdminPassword": {
              "type": "string"
            }
          }
        },
        "externalSecrets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "refreshInterval": {
              "type": "string"
            },
            "secretStoreRef": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": ["SecretStore", "ClusterSecretStore"]
                }
              }
            },
            "remoteRefs": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "extraArgs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
