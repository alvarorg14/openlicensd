{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":dependencyDashboard"
  ],
  "packageRules": [
    {
      "matchManagers": ["gomod"],
      "matchFileNames": ["server/**"],
      "labels": ["dependencies"]
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["ui/**"],
      "labels": ["dependencies"]
    },
    {
      "matchManagers": ["dockerfile"],
      "labels": ["dependencies"]
    },
    {
      "matchManagers": ["github-actions"],
      "labels": ["ci"]
    },
    {
      "matchManagers": ["custom.regex"],
      "matchDepNames": [
        "golangci/golangci-lint",
        "goreleaser/goreleaser",
        "golang.org/x/vuln"
      ],
      "labels": ["ci"]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/",
        "/^\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[A-Z_]+ \\?= (?<currentValue>\\S+)",
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+version: (?<currentValue>\\S+)"
      ]
    }
  ]
}
