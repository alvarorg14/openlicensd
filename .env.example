OPENLICENSD_ADDR=:8080
OPENLICENSD_DATABASE_URL=postgres://openlicensd:openlicensd@localhost:5432/openlicensd?sslmode=disable
# Database pool — 0 keeps pgx/Postgres defaults; non-zero env vars override pool_* URL query params
OPENLICENSD_DATABASE_MAX_CONNS=0
OPENLICENSD_DATABASE_MIN_CONNS=0
OPENLICENSD_DATABASE_MAX_CONN_IDLE_MINUTES=0
OPENLICENSD_DATABASE_STATEMENT_TIMEOUT_SECONDS=0
OPENLICENSD_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
OPENLICENSD_BOOTSTRAP_ADMIN_NAME=Administrator
# bcrypt hash for password "admin" — generate your own with: make hash-password PASSWORD=yourpassword
# Use single quotes so Docker Compose does not treat $ as variable interpolation.
OPENLICENSD_BOOTSTRAP_ADMIN_PASSWORD_HASH='$2a$10$w6lsMGg4BZVLWv0dqUXT2eUWcWhbh99FIECbPlBNeE.pu089T5E/2'
OPENLICENSD_SESSION_TTL_HOURS=24
OPENLICENSD_REQUEST_TIMEOUT_SECONDS=30
OPENLICENSD_SESSION_CLEANUP_INTERVAL_MINUTES=60
OPENLICENSD_COOKIE_SECURE=false
OPENLICENSD_LOCAL_LOGIN_ENABLED=true

# Logging
OPENLICENSD_LOG_LEVEL=info
OPENLICENSD_LOG_FORMAT=json

# Metrics — separate listener; not routed by Ingress
OPENLICENSD_METRICS_ENABLED=true
OPENLICENSD_METRICS_ADDR=:9090

# Rate limiting — set OPENLICENSD_TRUSTED_PROXIES when behind a reverse proxy
OPENLICENSD_TRUSTED_PROXIES=
OPENLICENSD_RATE_LIMIT_ENABLED=true
OPENLICENSD_RATE_LIMIT_BACKEND=memory
OPENLICENSD_RATE_LIMIT_PUBLIC_PER_MINUTE=600
OPENLICENSD_RATE_LIMIT_PUBLIC_BURST=60
OPENLICENSD_RATE_LIMIT_LOGIN_PER_MINUTE=30
OPENLICENSD_RATE_LIMIT_LOGIN_BURST=10
OPENLICENSD_RATE_LIMIT_IDLE_MINUTES=10

# OIDC SSO — see docs/oidc-sso.md for provider setup walkthroughs
OPENLICENSD_OIDC_ENABLED=false
OPENLICENSD_OIDC_ISSUER_URL=https://accounts.google.com
OPENLICENSD_OIDC_CLIENT_ID=
OPENLICENSD_OIDC_CLIENT_SECRET=
OPENLICENSD_OIDC_REDIRECT_URL=http://localhost:8080/api/v1/auth/oidc/callback
OPENLICENSD_OIDC_SCOPES=openid,profile,email
OPENLICENSD_OIDC_DEFAULT_ROLE=viewer
OPENLICENSD_OIDC_PROVIDER_NAME=Google
OPENLICENSD_OIDC_ADMIN_EMAILS=

OPENLICENSD_HARBOR_ENABLED=false
OPENLICENSD_HARBOR_URL=https://harbor.example.com
OPENLICENSD_HARBOR_ADMIN_USERNAME=admin
OPENLICENSD_HARBOR_ADMIN_PASSWORD=change-me
OPENLICENSD_HARBOR_PROJECTS=myproject
OPENLICENSD_HARBOR_ROBOT_DURATION_DAYS=1
OPENLICENSD_HARBOR_ROBOT_NAME_PREFIX=openlicensd
OPENLICENSD_HARBOR_INSECURE_SKIP_VERIFY=false
OPENLICENSD_HARBOR_DEBUG=false
